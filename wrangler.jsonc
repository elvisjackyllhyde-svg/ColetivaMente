{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coletivamente",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "coletivamente.app",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "QUIZ_ROOMS", "class_name": "QuizRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["QuizRoom"] }
  ]
}
